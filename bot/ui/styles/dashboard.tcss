/*
 * Trading Dashboard v2 - Responsive Layout
 *
 * 3 market columns (BTC | ETH | SOL) arranged horizontally
 * Each column contains indicator sub-columns + scrollable log
 */

/* ============================================================
 * Screen & Base
 * ============================================================ */

Screen {
    background: #0a0a0a;
}

/* ============================================================
 * Title Bar
 * ============================================================ */

#title-bar {
    background: #1a1a2e;
    color: #00ffff;
    text-style: bold;
    height: 2;
    padding: 0 1;
    width: 100%;
}

/* ============================================================
 * Strategy Panel - Shows current strategy and weight histogram
 * ============================================================ */

#strategy-panel {
    height: 1;
    width: 100%;
    background: #121218;
    border-bottom: solid #333333;
    padding: 0 1;
}

.strategy-header {
    height: 1;
    width: 100%;
    padding: 0 1;
}

.strategy-name {
    color: #00ff88;
    text-style: bold;
    width: auto;
    padding: 0 2 0 0;
}

.strategy-threshold {
    color: #888888;
    width: auto;
    padding: 0 2 0 0;
}

.strategy-hint {
    color: #555555;
    width: auto;
}

/* ============================================================
 * Main Content - Horizontal Layout for 3 Market Columns
 * ============================================================ */

.main-content {
    height: 1fr;
    width: 100%;
}

/* ============================================================
 * Market Column - Each gets equal width (1fr = 33%)
 * ============================================================ */

MarketColumn {
    width: 1fr;
    height: 100%;
    border: solid #333333;
    background: #0f0f0f;
}

.market-header {
    background: #1a1a2e;
    color: #ffffff;
    text-style: bold;
    text-align: center;
    height: 3;
    padding: 1 0;
    width: 100%;
}

/* ============================================================
 * Indicators Row - Horizontal sub-columns
 * ============================================================ */

.indicators-row {
    height: 12;
    width: 100%;
}

/* ============================================================
 * Indicator Sub-Column - Each indicator type
 * ============================================================ */

.indicator-subcolumn {
    width: 1fr;
    height: 100%;
    border-right: solid #222222;
    padding: 0 1;
}

.indicator-subcolumn:last-child {
    border-right: none;
}

.subcolumn-title {
    background: #1a1a1a;
    color: #888888;
    text-style: bold;
    text-align: center;
    height: 1;
    padding: 0;
    width: 100%;
}

.subcolumn-values {
    color: #cccccc;
    height: 1fr;
    padding: 0 0;
}

.subcolumn-progress {
    color: #aaaaaa;
    height: 2;
    padding: 0 0;
    text-align: center;
    border-top: solid #333333;
}

/* ============================================================
 * Combined Signal Row
 * ============================================================ */

.combined-row {
    height: auto;
    width: 100%;
    border-top: solid #00ff88;
}

.combined-section {
    height: auto;
    padding: 1;
    background: #0f0f0f;
}

.combined-signal {
    color: #00ff88;
    text-style: bold;
    height: 2;
}

.contributions {
    color: #888888;
    height: 2;
}

/* ============================================================
 * Scrollable Signal Log
 * ============================================================ */

.signal-log {
    height: 1fr;
    min-height: 8;
    background: #0a0a0a;
    border-top: solid #333333;
    scrollbar-background: #1a1a1a;
    scrollbar-color: #333333;
}

.log-content {
    padding: 1;
    color: #666666;
}

/* ============================================================
 * Missing Data State
 * ============================================================ */

.missing-data-container {
    height: 1fr;
    width: 100%;
    align: center middle;
    padding: 2;
}

.missing-data-warning {
    color: #ffaa00;
    text-style: bold;
    text-align: center;
    width: 100%;
    height: 3;
}

.missing-data-detail {
    color: #888888;
    text-align: center;
    width: 100%;
    height: 2;
}

.missing-data-hint {
    color: #555555;
    text-align: center;
    width: 100%;
    height: 2;
}

/* ============================================================
 * Single-Column Layout (Client Mode)
 * Applied via .single-column class when only one market is displayed
 * ============================================================ */

MarketColumn.single-column {
    width: 100%;
}

MarketColumn.single-column .indicators-row {
    height: 2fr;
}

MarketColumn.single-column .indicator-subcolumn {
    min-width: 20;
}

MarketColumn.single-column .subcolumn-values {
    height: 1fr;
    padding: 1;
}

MarketColumn.single-column .signal-log {
    height: 1fr;
    min-height: 12;
}

/* ============================================================
 * Semantic Colors for Signals
 * ============================================================ */

.signal-long {
    color: #00ff88;
}

.signal-short {
    color: #ff4444;
}

.signal-wait {
    color: #888888;
}
